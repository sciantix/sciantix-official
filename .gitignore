########################################
# Test-suite run artifacts
#
# Regenerated by every `./runTesting.sh` / `python3 -m testing.runner` run, so
# tracking them made any run dirty the tree -- and the content itself depends on
# the build (an --oc build fills the CALPHAD columns, a plain one leaves zeros).
# The committed reference is output_gold.txt, which stays tracked.
# Note: utilities/postProcessing/output.txt is a fixture, not a run artifact.
########################################

validation/**/output.txt
verification/**/output.txt
validation/**/thermochemistry_output.txt
verification/**/thermochemistry_output.txt
validation/**/error_log.txt
verification/**/error_log.txt
validation/**/*_plot_data.tsv
verification/**/*.tsv
verification/**/.matplotlib/
testing/report.html
