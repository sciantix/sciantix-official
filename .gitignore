# Object files
*.o
*.obj
*.lo
*.slo

# Dependency files
*.d

# Precompiled headers
*.gch
*.pch

# Static / shared libraries
*.a
*.la
*.lai
*.lib
*.so
*.dylib
*.dll

# Fortran modules
*.mod
*.smod

# Executables
*.exe
*.out
*.app
*.x
sciantix.x


