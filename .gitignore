# Object files
*.o
*.obj
*.lo
*.slo

# Dependency files
*.d

# Precompiled headers
*.gch
*.pch

# Static / shared libraries
*.a
*.la
*.lai
*.lib
*.so
*.dylib
*.dll

# Fortran modules
*.mod
*.smod

# Executables
*.exe
*.out
*.app
*.x
sciantix.x


########################################
# CMake
########################################

build/
obj/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json


########################################
# Doxygen & Sphinx generated content
########################################

docs/build/
docs/doxygen/
docs/source/api/
latex/

# Written by the regression runner on every run
regression/report.html

# Written by ErrorMessages next to the case that produced it
error_log.txt


########################################
# Python
########################################

__pycache__/
*.pyc


########################################
# Editors / IDEs
########################################

.vscode/
.vs/


########################################
# OS / misc junk
########################################

*.bak
.DS_Store
Testing/


########################################
# Project-specific
########################################

bin/
out/
*.png

# ...except the HBS-formation figures, which document
# iHighBurnupStructureFormation = 4 and are regenerated from that directory by
# compare_formation_options.py, validation.py and calibrate.py --front
!utilities/HBSformation/figures/*.png

# ...and the HBS regression figures carrying the Landau overlay, written by
# regression/hbs/plot.py --landau.  The manuscript figures next to them are
# tracked already and are not touched by that mode.
!regression/hbs/figures/*_landau.png