########################################
# Generic build artifacts
########################################

# Object files
*.o
*.obj
*.lo
*.slo

# Dependency files
*.d

# Precompiled headers
*.gch
*.pch

# Static / shared libraries
*.a
*.la
*.lai
*.lib
*.so
*.dylib
*.dll

# Fortran modules
*.mod
*.smod

# Executables
*.exe
*.out
*.app
*.x
sciantix.x


########################################
# CMake
########################################

build/
obj/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json


########################################
# Doxygen & Sphinx generated content
########################################

docs/build/
docs/doxygen/
docs/source/api/
latex/

# Written by the regression runner on every run
regression/report.html

# Written by ErrorMessages next to the case that produced it
# Templates written by the generators in utilities/inputExample/. Scoped to that folder:
# input_settings.txt and friends are real, tracked inputs everywhere else.
utilities/inputExample/*.txt

# SCIANTIX run artefacts: regenerated on every execution, never meant to be committed
error_log.txt
input_check.txt
execution.txt
overview.txt



########################################
# Python
########################################

__pycache__/
*.pyc


########################################
# Editors / IDEs
########################################

.vscode/
.vs/


########################################
# OS / misc junk
########################################

*.bak
.DS_Store
Testing/


########################################
# Project-specific
########################################

bin/
out/
# Figures are regenerable artefacts, not documentation: every regression group writes
# its plots into <group>/figures/ and plotter.sh rebuilds the lot. Nothing under a
# figures/ directory is meant to be committed.
*.png
# NUS parametric studies: generated cases and their outputs
regression/nus/studies/runs/

#COARSENING: keep inputs, selected results and figures; exclude raw run files.
/regression/White_Coarsening/runs/
!/regression/White_Coarsening/figures/**/*.png
!/context/dislocation_density/figures/*.png
# Regression figures are PNG-only; exclude any SVGs left by older generators.
/regression/White_Coarsening/figures/**/*.svg
# Ignore stale vector outputs; maintained density-fit figures are PNG-only.
/context/dislocation_density/figures/*.svg
/regression/White_Coarsening/results.json
/regression/White_Coarsening/verification.json
/regression/White_Coarsening/endpoints.csv
/context/dislocation_density/refit_verification.json
/context/dislocation_density/source_manifest.json

# White 2006 observations beyond the published Barani dataset stay local.
/context/dislocation_density/data/white*
/context/dislocation_density/figures/white*
/regression/White_Coarsening/data/white_4070*
/regression/White_Coarsening/inputs/4070*/
/regression/White_Coarsening/figures/06_preramp_4070.*
/sciantix_coarsening_local/
