# Object files
*.o
*.obj
*.lo
*.slo

# Dependency files
*.d

# Precompiled headers
*.gch
*.pch

# Static / shared libraries
*.a
*.la
*.lai
*.lib
*.so
*.dylib
*.dll

# Fortran modules
*.mod
*.smod

# Executables
*.exe
*.out
*.app
*.x
sciantix.x


########################################
# CMake
########################################

build/
obj/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json


########################################
# Doxygen & Sphinx generated content
########################################

docs/build/
docs/doxygen/
docs/source/api/
latex/

# Written by the regression runner on every run
regression/report.html

# Written by ErrorMessages next to the case that produced it
# Templates written by the generators in utilities/inputExample/. Scoped to that folder:
# input_settings.txt and friends are real, tracked inputs everywhere else.
utilities/inputExample/*.txt

# SCIANTIX run artefacts: regenerated on every execution, never meant to be committed
error_log.txt
input_check.txt
execution.txt
overview.txt



########################################
# Python
########################################

__pycache__/
*.pyc


########################################
# Editors / IDEs
########################################

.vscode/
.vs/


########################################
# OS / misc junk
########################################

*.bak
.DS_Store
Testing/


########################################
# Project-specific
########################################

bin/
out/
*.png


########################################
# OpenCalphad
########################################

*.TDB

########################################
# Thermo-Calc reference tables
########################################

TEMPERATURES_THERMOCALC*/
regression/JOG/PHENIXpins/support/*
########################################
# Test-suite run artifacts
#
# Regenerated by every `./runTesting.sh` / `python3 -m testing.runner` run.
# The committed reference is output_gold.txt, which stays tracked.
# Note: utilities/postProcessing/output.txt is a fixture, not a run artifact.
########################################

validation/**/output.txt
verification/**/output.txt
validation/**/thermochemistry_output.txt
verification/**/thermochemistry_output.txt
validation/**/error_log.txt
verification/**/error_log.txt
validation/**/*_plot_data.tsv
verification/**/*.tsv
verification/**/.matplotlib/
testing/report.html

# Thermochemistry run outputs (regenerated by running the case)
validation/**/phase_sublattice_composition.txt
verification/**/phase_sublattice_composition.txt

# NUS parametric studies (verification/test_nus/studies): generated cases and their outputs
verification/test_nus/studies/runs/
