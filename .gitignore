# CMake
########################################

build/
obj/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json


########################################
# Doxygen & Sphinx generated content
########################################

docs/build/
docs/doxygen/
docs/source/api/
latex/

# Written by the regression runner on every run
regression/report.html

# Written by ErrorMessages next to the case that produced it
# SCIANTIX run artefacts: regenerated on every execution, never meant to be committed
error_log.txt
input_check.txt
execution.txt
overview.txt

# global sensitivity analysis: scratch runs, cached arrays and report
utilities/GSA_runs/
utilities/GSA_output_files/
utilities/GSA_report.txt


########################################
# Python
########################################

__pycache__/
*.pyc


########################################
# Editors / IDEs
########################################

.vscode/
.vs/


########################################
# OS / misc junk
########################################

*.bak
.DS_Store
Testing/


########################################
# Project-specific
########################################

bin/
out/
# Figures are regenerable artefacts, not documentation: every regression group writes
# its plots into <group>/figures/ and plotter.sh rebuilds the lot. Nothing under a
# figures/ directory is meant to be committed.
*.png
# NUS parametric studies: generated cases and their outputs
regression/nus/studies/runs/
