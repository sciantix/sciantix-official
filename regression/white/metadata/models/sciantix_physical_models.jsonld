{
  "@context": {
    "dcterms": "http://purl.org/dc/terms/",
    "nmkos": "https://w3id.org/nm-kos/terms#",
    "model": "https://w3id.org/nm-kos/sciantix/model#",
    "category": "nmkos:category",
    "targetDescription": "nmkos:targetDescription",
    "mainAssumptions": "nmkos:mainAssumptions",
    "reference": {
      "@id": "dcterms:references",
      "@type": "@id"
    }
  },
  "@type": "nmkos:ModelCatalog",
  "dcterms:identifier": "sciantix-white-physical-models",
  "dcterms:title": "SCIANTIX physical models relevant to the White case study",
  "dcterms:source": "../sources/sciantix_model_references.jsonld",
  "nmkos:model": [
    {
      "@id": "model:densification",
      "@type": "nmkos:PhysicalModel",
      "dcterms:title": "Densification",
      "category": "Microstructure, semiempirical",
      "targetDescription": "Burnup driven fuel densification, represented as a progressive reduction of the fabrication porosity towards a residual porosity.",
      "mainAssumptions": "Empirical fit, temperature and burnup dependent only.",
      "reference": "model-ref:van-uffelen-2002"
    },
    {
      "@id": "model:grain-growth",
      "@type": "nmkos:PhysicalModel",
      "dcterms:title": "Grain growth",
      "category": "Microstructure, physics-based model",
      "targetDescription": "Grain radius growth during irradiation as a function of temperature, burnup and grain-boundary mobility.",
      "mainAssumptions": "Pinning effect of secondary phases is neglected.",
      "reference": "model-ref:ainscough-1973"
    },
    {
      "@id": "model:gas-production",
      "@type": "nmkos:PhysicalModel",
      "dcterms:title": "Gas production",
      "category": "Fission gas behaviour, physics-based model",
      "targetDescription": "Production of gaseous species from fission, calculated via local fission rate and gas fission yields.",
      "mainAssumptions": "Constant fission yields.",
      "reference": "model-ref:standard-fission-gas-production-law"
    },
    {
      "@id": "model:gas-diffusion",
      "@type": "nmkos:PhysicalModel",
      "dcterms:title": "Gas diffusion",
      "category": "Fission gas behaviour, physics-based model",
      "targetDescription": "Intra-granular fission gas diffusion solving for gas concentration in intragranular solution and in intragranular bubbles.",
      "mainAssumptions": "Spherical grains with uniform temperature; quasi-steady-state between gas atoms and bubbles.",
      "reference": "model-ref:standard-spectral-diffusion-law"
    },
    {
      "@id": "model:intragranular-bubble-behaviour",
      "@type": "nmkos:PhysicalModel",
      "dcterms:title": "Intragranular bubble behaviour",
      "category": "Fission gas behaviour, physics-based model",
      "targetDescription": "Intragranular bubble population, atoms per bubble, bubble radius, and intragranular gaseous swelling. Intragranular bubble concentration is evolved with a simple source-decay law; bubble radius and volume are inferred from gas inventories stored in intragranular bubbles.",
      "mainAssumptions": "Stationary bubbles; uncertainties in bubble nucleation, gas-atom trapping, and resolution models.",
      "reference": "model-ref:pizzocri-2018"
    },
    {
      "@id": "model:intergranular-bubble-behavior",
      "@type": "nmkos:PhysicalModel",
      "dcterms:title": "Intergranular bubble behavior",
      "category": "Fission gas behaviour, physics-based model",
      "targetDescription": "Intergranular bubble evolution, including bubble volume, radius, area, fractional coverage, bubble pressure, intergranular gas swelling, and released inventories.",
      "mainAssumptions": "Standard bubble shape.",
      "reference": "model-ref:pastore-2013"
    },
    {
      "@id": "model:grain-boundary-micro-cracking",
      "@type": "nmkos:PhysicalModel",
      "dcterms:title": "Grain-boundary micro-cracking",
      "category": "Fission gas behaviour, physics-based model",
      "targetDescription": "Degradation of grain-boundary integrity during transients and progressive healing with burnup.",
      "mainAssumptions": "Unique bubble size, pressure, and shape; grain-boundary healing is empirically derived from burnup.",
      "reference": [
        "model-ref:barani-2017",
        "model-ref:cappellari-2025"
      ]
    },
    {
      "@id": "model:grain-boundary-venting",
      "@type": "nmkos:PhysicalModel",
      "dcterms:title": "Grain-boundary venting",
      "category": "Fission gas behaviour, physics-based model",
      "targetDescription": "Venting of gases from grain-boundary edges to the free volume, given the fuel open porosity.",
      "mainAssumptions": "Strongly dependent on the densification model.",
      "reference": "model-ref:claisse-2015"
    }
  ]
}
